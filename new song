midi = MIDIFile(1)
track = 0
time = 0  # Start at the beginning
tempo = 75  # BPM (slow, emotional)
channel = 0
volume = 100
duration = 2  # Each chord lasts 2 beats

# Set the tempo
midi.addTempo(track, time, tempo)

# Define chords as MIDI note lists
chords = [
    # Verse
    [57, 60, 64],  # Am
    [53, 57, 60],  # F
    [48, 52, 55],  # C
    [55, 59, 62],  # G
    [57, 60, 64],  # Am
    [53, 57, 60],  # F
    [48, 52, 55],  # C
    [55, 59, 62],  # G
    [50, 53, 57],  # Dm
    [53, 57, 60],  # F
    [48, 52, 55],  # C
    [55, 59, 62],  # G
    [50, 53, 57],  # Dm
    [53, 57, 60],  # F
    [55, 59, 62],  # G
    [55, 59, 62],  # G

    # Pre-Chorus
    [53, 57, 60],  # F
    [48, 52, 55],  # C
    [55, 59, 62],  # G
    [57, 60, 64],  # Am
    [53, 57, 60],  # F
    [48, 52, 55],  # C
    [55, 59, 62],  # G
    [55, 59, 62],  # G

    # Chorus
    [57, 60, 64],  # Am
    [53, 57, 60],  # F
    [48, 52, 55],  # C
    [55, 59, 62],  # G
    [57, 60, 64],  # Am
    [53, 57, 60],  # F
    [48, 52, 55],  # C
    [55, 59, 62],  # G
    [50, 53, 57],  # Dm
    [53, 57, 60],  # F
    [48, 52, 55],  # C
    [55, 59, 62],  # G
    [50, 53, 57],  # Dm
    [53, 57, 60],  # F
    [55, 59, 62],  # G
    [55, 59, 62],  # G
]

# Add the chords to the MIDI track
for chord in chords:
    for note in chord:
        midi.addNote(track, channel, note, time, duration, volume)
    time += duration

# Save the MIDI file
with open("Only_When_Youre_Drunk_Chords.mid", "wb") as output_file:
    midi.writeFile(output_file)

print("✅ MIDI file created: Only_When_Youre_Drunk_Chords.mid")
